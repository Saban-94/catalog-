rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers (Phase 3) ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    // Identity check - Initial admin email provided by runtime metadata
    function isAdmin() { 
      return isVerified() && request.auth.token.email == "hsaban2025@gmail.com"; 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // --- Entity Validations (Pillar 2) ---
    function isValidProduct(data) {
      return data.keys().hasAll(['sku', 'productName', 'price', 'stock']) &&
             data.sku is string && data.sku.size() <= 64 &&
             data.productName is string && data.productName.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.stock is number &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt == request.time));
    }

    function isValidLog(data) {
      return data.keys().hasAll(['userQuery', 'aiResponse', 'timestamp']) &&
             data.userQuery is string && data.userQuery.size() <= 2000 &&
             data.aiResponse is string && data.aiResponse.size() <= 5000 &&
             data.timestamp == request.time &&
             (!('userId' in data) || (data.userId == request.auth.uid)) &&
             (!('sku' in data) || (data.sku is string && data.sku.size() <= 64));
    }

    // --- Collections (Phase 4) ---

    // Inventory (Pillar 1/4/9)
    match /inventory/{productId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming()) && (
        incoming().sku == existing().sku // Immutable SKU
      );
      allow delete: if isAdmin();
    }

    // AI Logs (Pillar 8/10)
    match /ai_logs/{logId} {
      // Secure list: forcing client to query by userId if not admin
      allow list: if isAdmin(); 
      allow get: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(logId) && isValidLog(incoming());
      allow update, delete: if false; // Logs are immutable resources
    }
  }
}
